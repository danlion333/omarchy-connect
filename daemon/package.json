{
  "name": "omarchy-connect-daemon",
  "version": "0.2.0",
  "description": "Omarchy Connect daemon \u2014 bridges an Omarchy desktop with the mobile app over the LAN",
  "type": "module",
  "license": "MIT",
  "bin": {
    "omarchy-connect": "bin/omarchy-connect.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node bin/omarchy-connect.js start",
    "pair": "node bin/omarchy-connect.js pair",
    "test": "node ../tools/run-tests.mjs daemon",
    "test:tls": "node test/tls.mjs",
    "test:calls": "node test/calls.mjs",
    "test:call-close": "node test/call-close.mjs",
    "test:call-abandoned": "node test/call-abandoned.mjs",
    "test:otp": "node test/otp.mjs",
    "test:locate": "node test/locate.mjs",
    "test:ios": "node test/ios.mjs",
    "test:agents": "node test/agents.mjs && node test/agent-status.mjs && node test/agent-draft.mjs && node test/agent-submit.mjs && node test/remote.mjs",
    "test:terminal": "node test/terminal.mjs",
    "test:terminal-panel": "node test/terminal-panel.mjs",
    "test:hostname": "node test/hostname.mjs",
    "test:announce": "node test/announce.mjs",
    "test:overlay": "node test/overlay.mjs",
    "test:remote": "node test/remote.mjs",
    "test:dictation": "node test/dictation.mjs",
    "test:audio": "node test/audio.mjs",
    "test:audio-level": "node test/audio-level.mjs",
    "test:audio-input": "node test/audio-input.mjs",
    "test:resample": "node test/resample.mjs",
    "test:audio-panel": "node test/audio-panel.mjs",
    "test:upload-names": "node test/upload-names.mjs",
    "test:local-auth": "node test/local-auth.mjs",
    "test:hygiene": "node test/hygiene.mjs",
    "test:clipboard-image": "node test/clipboard-image.mjs",
    "test:config": "node test/config.mjs",
    "test:cpu-temp": "node test/cpu-temp.mjs",
    "test:replay": "node test/replay.mjs",
    "test:mirror-dedupe": "node test/mirror-dedupe.mjs",
    "test:sms-reply": "node test/sms-reply.mjs",
    "test:hello-write": "node test/hello-write.mjs",
    "test:file-crypto": "node test/file-crypto.mjs"
  },
  "dependencies": {
    "ws": "^8.18.3"
  }
}
