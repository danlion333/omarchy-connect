<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!--
    What keeps the desktop link alive when nobody is looking at the phone.

    Android stops this app's JavaScript timers the moment the activity pauses
    and reclaims the process altogether once the task is swiped away — which
    took the WebSocket, the keepalive ping and the reconnect backoff with it.
    A foreground service is the only sanctioned way to say "this process is
    talking to a device the user cares about, leave it running".

    `connectedDevice` rather than `dataSync` on purpose: dataSync is capped at
    a few hours a day since Android 14, and a link to your own desktop is
    exactly the case connectedDevice describes. It requires the app to hold one
    of a short list of permissions to prove the claim — CHANGE_NETWORK_STATE is
    the cheapest of them and is granted at install time.
  -->
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
  <!--
    The phone as a microphone the desktop can switch on — see `Mic`.

    `RECORD_AUDIO` itself is declared by the app (dictation has always needed
    it); what is declared here is the right to go on recording once nobody is
    looking at the screen. From Android 14 a foreground service that uses the
    microphone must hold this permission and must name `microphone` among its
    types, or the capture is stopped the moment the app stops being visible —
    which is precisely the case this feature exists for.

    The type is claimed on the service that already exists rather than by a
    second service, and it is claimed only while something is actually
    recording: `LinkService.holdMicrophone` says why at length.
  -->
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
  <!--
    The phone as a camera the desktop can switch on — see `Camera`.

    `CAMERA` itself is declared by the app (the pairing QR scanner has always
    needed it); what is declared here is the right to go on filming once
    nobody is looking at the screen. The Android 14 rule is the microphone's
    rule one rung up, and the same reasoning applies to claiming the type on
    the service that already exists rather than on a second one, and only
    while something is actually filming: `LinkService.holdCamera`.
  -->
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />

  <!--
    This desktop's sound, out of the phone's speaker — see `Speaker`.

    Playing needs no runtime permission of its own; what this is for is the
    right to go on playing once the app is out of sight, which is the only
    state a phone being used as a speaker is ever in. Claimed on the service
    that already exists and only while a track is open, exactly as the two
    above are: `LinkService.holdPlayback`.
  -->
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
  <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
  <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
  <!--
    A phone asked to say where it is buzzes as well as rings — a handset under
    a cushion is heard as much as it is felt. Granted at install time; nothing
    here asks for it at runtime.
  -->
  <uses-permission android:name="android.permission.VIBRATE" />

  <!--
    Hearing the desktop announce itself on the subnet — see `Announce`.

    A Wi-Fi radio in power save drops frames that are not addressed to this
    device, and a subnet broadcast is one of those. CHANGE_WIFI_MULTICAST_STATE
    is what allows the lock that turns that filter off; it is named for
    multicast and has always covered broadcast too. ACCESS_WIFI_STATE is what
    lets the app hold a WifiManager to take the lock from.

    WAKE_LOCK is for the seconds after a packet arrives and no longer than
    that. The link itself holds none — `LinkService` explains why at length —
    but the processor stays awake only as long as it takes to hand a datagram
    over, and reconnecting is a TCP connect and a TLS handshake. A twenty
    second, self-releasing hold around one announcement is a different animal
    from an untimed lock held all day.
  -->
  <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
  <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
  <uses-permission android:name="android.permission.WAKE_LOCK" />

  <application>
    <service
      android:name=".LinkService"
      android:exported="false"
      android:foregroundServiceType="connectedDevice|microphone|camera|mediaPlayback"
      android:stopWithTask="false" />

    <!--
      The buttons on this app's notifications: the reply box on a waiting
      agent, and the reconnect on the link line. Not exported — the only thing
      that ever sends these is a PendingIntent this app built itself, and a
      receiver that answers anyone would let any app on the phone type into a
      coding agent.
    -->
    <receiver
      android:name=".LinkActionReceiver"
      android:exported="false" />

    <!--
      How a picture leaves this app for another one's paste buffer.

      A clipboard cannot carry bytes: what it carries is a `content://` URI,
      and the app that pastes it reads through this provider. Not exported, and
      pointed at one directory — the offer cache — so the grant the system
      hands a pasting app is a grant to exactly the picture that was copied.
      `grantUriPermissions` is what makes that temporary grant possible at all.
    -->
    <provider
      android:name=".ClipFileProvider"
      android:authorities="${applicationId}.omarchylink.clips"
      android:exported="false"
      android:grantUriPermissions="true">
      <meta-data
        android:name="android.support.FILE_PROVIDER_PATHS"
        android:resource="@xml/omarchy_link_clips" />
    </provider>

    <!--
      A phone that reboots overnight would otherwise be missing from the
      desktop until somebody thought to open the app. BOOT_COMPLETED is one of
      the few broadcasts still allowed to start a foreground service from the
      background, which is what makes this work at all.
    -->
    <receiver
      android:name=".BootReceiver"
      android:exported="true"
      android:enabled="true">
      <intent-filter>
        <action android:name="android.intent.action.BOOT_COMPLETED" />
        <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
      </intent-filter>
    </receiver>
  </application>
</manifest>
